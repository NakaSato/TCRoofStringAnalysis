**/.DS_Store
data/
secrets/
.env
.env.*
**/*.db
**/*.db-*
**/*.sqlite3
docs/
specs/
billing/
ipswitcher/
Monitoring Report/
sample_data/
backend/tests/
**/node_modules/
frontend/dist/
frontend/tsconfig.tsbuildinfo
