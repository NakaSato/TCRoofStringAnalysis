# TC Roof Solar PV O&M Full-Stack Configuration
DATABASE_URL=sqlite:///./data/solar_fullstack.db
JWT_SECRET_KEY=tc-roof-solar-super-secret-jwt-key-2026-engineering
JWT_EXPIRE_MINUTES=10080
VITE_API_BASE_URL=/api
# Plant Map basemap (set in frontend/.env, read at build time): a public Mapbox pk. token, restrict it by URL at Mapbox; empty = Esri tiles
# VITE_MAPBOX_TOKEN=

# Growatt OpenAPI v1: one account per project phase, each with its own token (real tokens in .env only).
# Plants are tagged with the phase whose account lists them. Leave a phase empty to skip it.
GROWATT_TOKEN_PHASE1=
GROWATT_TOKEN_PHASE2=
GROWATT_TOKEN_PHASE3=
GROWATT_TOKEN_PHASE4=
# Legacy single-account token; used as phase 1 only when GROWATT_TOKEN_PHASE1 is empty.
GROWATT_API_TOKEN=
GROWATT_BASE_URL=https://openapi.growatt.com/v1/
# Growatt plant ids the app ignores (comma separated): not listed, not synced, removed from the registry.
# GROWATT_BLOCKED_PLANT_IDS=10838528   # สถานีจ่ายน้ำบางแสน กปภ.ชลบุรี ver.2
# Weather Sensors page: live online state (env_list per datalogger, memory only), swept a few
# dataloggers per request only while the page is open. Raise the TTL to 600 if 10012s rise.
SENSOR_STATUS_TTL_S=300
SENSOR_SWEEP_PER_REQUEST=12
PLANT_TODAY_TTL_S=300
PLANT_TODAY_SWEEP_PER_REQUEST=40
INVERTER_SNAPSHOT_TTL_S=300
INVERTER_SNAPSHOT_SWEEP_PER_REQUEST=4
SENSOR_LATE_MIN=15
SENSOR_OFFLINE_MIN=60
SENSOR_ALARM_COVERAGE_PCT=80
# System → Logs (app_logs in SQL, admins only)
LOG_DB_ENABLED=true
LOG_DB_LEVEL=INFO
LOG_RETENTION_DAYS=14
LOG_MAX_ROWS=500000
LOG_FLUSH_INTERVAL_S=5
LOG_BUFFER_MAX=5000
LOG_SLOW_REQUEST_MS=5000

# Firestore: daily summaries only (never realtime). Service-account key stays on the backend.
FIREBASE_PROJECT_ID=tcroof-string-analysis
FIREBASE_CREDENTIALS_FILE=secrets/firebase-service-account.json
PUBLISH_DAILY_WRITE_BUDGET=15000
PUBLISH_SINK=json  # json | firestore

# Alarm push notifications (Firebase Cloud Messaging web push). The four values are the Firebase
# web app's public config (bunx firebase-tools apps:sdkconfig WEB) and the Web Push certificate
# key (console > Project settings > Cloud Messaging); any empty = push off. The worker sends with
# FIREBASE_CREDENTIALS_FILE after each `alarms` run; prod values: deploy/gcp.config.
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_VAPID_KEY=
PUSH_ALARM_LEVELS=fault            # fault | fault,warning | fault,warning,info
PUSH_ALARM_MAX_AGE_MIN=90          # an event last reported longer ago is not pushed
PUSH_ALARM_REPEAT_MIN=120          # the same inverter + code: at most one push in this time
PUSH_MAX_PLANTS_PER_USER=5         # more plants with new alarms in one run = one summary push

# Production only (deploy/gcp.sh sets these): APP_ENV=prod seeds a single admin, no demo users/data.
# APP_ENV=prod
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=            # >= 12 characters; deploy reads it from Secret Manager
# WORKER_ALARMS_TICK_MIN=10  # alarm log sync (today), between WORKER_ALARMS_START_H/_END_H (5/20)
# WORKER_ALARMS_HOT_MIN=10   # per-inverter re-read: open alarm / fault status
# WORKER_ALARMS_WARM_MIN=30  # alarms today, all closed
# WORKER_ALARMS_COLD_MIN=60  # no alarms today
# WORKER_HISTORY_INTERVAL_MIN=10 # history (max_data + meter_data) pull, all day
# METER_HISTORY_ENABLED=true     # energy-meter history (meter_data) with history / backfill; false skips it
# WORKER_ENV_INTERVAL_MIN=10     # weather-sensor history only, between WORKER_ENV_START_H/_END_H (5/20); 0 = off
# WORKER_LATEST_INTERVAL_MIN=0   # inverter_latest: each inverter's newest record (maxs_data) into the history tables, between WORKER_LATEST_START_H/_END_H (5/20); 0 = off, at least 5
# WORKER_HISTORY_BATCH_SIZE=0    # history: inverters per queryDevicesHistoricalData call (max_data per inverter as fallback); 0 = off
# HISTORY_RETENTION_DAYS=90  # raw readings older than this are deleted daily
# HISTORY_STORE_RAW=true  # keep every field of each inverter max_data record (growatt_inverter_raw, ~4 kB a record)
# HISTORY_RAW_RETENTION_DAYS=30  # those whole records are deleted after this many days

# Google Maps Platform Weather API (modelled weather per plant; backend only).
# Restrict the key to the Weather API in Cloud Console. 10k free calls/month.
GOOGLE_WEATHER_API_KEY=
GOOGLE_WEATHER_MONTHLY_BUDGET=30000
GOOGLE_WEATHER_HISTORY_HOURS_PER_DAY=4000
GOOGLE_WEATHER_DAY_START_H=6
GOOGLE_WEATHER_DAY_END_H=18
GOOGLE_WEATHER_LIVE_TTL_S=1800

# Longdo Map Weather Radar API (https://weather.longdo.com/docs): rain radar on the Plant Map and
# radar rain over a plant now / +15 / +30 min (memory only). Empty = off. The browser loads the
# radar tiles itself, so signed-in users receive this key: restrict it by domain at Longdo Map.
LONGDO_API_KEY=
# Longdo allows 100,000 calls/month and 60/min. The backend counts its own calls and keeps to:
# LONGDO_MONTHLY_BUDGET=60000       # the rest is left for the radar tiles the browsers load
# LONGDO_CALLS_PER_MIN=30
# seconds one Longdo call may take
# LONGDO_TIMEOUT_S=6
# of those, calls per minute the fleet rain sweep leaves for the selected plant and the snapshot list
# LONGDO_INTERACTIVE_RESERVE_PER_MIN=8
# LONGDO_RADAR_TTL_S=300
# LONGDO_RAIN_TTL_S=300
# LONGDO_AREA_RADIUS_KM=10          # "rain nearby" circle around the selected plant
# LONGDO_FLEET_RAIN_TTL_S=1800      # rain now over every plant (area per 1° region, then per plant where it rains), only while the radar is on
# LONGDO_RAIN_SWEEP_PER_REQUEST=20

# PWA report checks 09 / 13 / 17 are snapshots at hh:00 - CHECK_OFFSET_MIN (08:50 / 12:50 / 16:50),
# published then; `history` is pulled PWA_HISTORY_LEAD_MIN before (08:47 / 12:47 / 16:47).
CHECK_OFFSET_MIN=10
PWA_HISTORY_LEAD_MIN=3
# A check's DATA LOG lists only the alarm messages from hh:00 minus this many minutes (08:30) to its snapshot.
PWA_FAULT_LOOKBACK_MIN=30
# Reading warning codes (max_data warnCode, comma separated) the DATA LOG leaves out when the alarm log has nothing.
PWA_IGNORE_WARN_CODES=1
# Monitoring PWA Report Google Sheet (worker fills one DD.MM tab per day: 06:05 create, checks at
# 08:50 / 12:50 / 16:50 / 19:30, empty cells only). Empty = off (the Apps Script fills the sheet).
# The ID is in the sheet URL /spreadsheets/d/<id>/edit.
# The worker writes as the service account below (default FIREBASE_CREDENTIALS_FILE): share the
# sheet with its client_email as Editor, and enable the Sheets API (deploy/gcp.sh backend does).
PWA_SHEET_ID=
# PWA_SHEET_CREDENTIALS_FILE=secrets/pwa-sheet-service-account.json
# Shared key for GET /api/report/pwa/{day} (header X-Report-Key; Apps Script fallback). Empty = off.
# Prod: Secret Manager tcroof-report-key.
REPORT_API_KEY=

# AI Assistant (docs/plans/ai-assistant.md). Empty key = off. Qwen Cloud Model Studio
# (Singapore) via its Anthropic-compatible endpoint; prod: Secret Manager tcroof-ai-api-key.
AI_API_KEY=
AI_BASE_URL=https://ap-southeast-1.maas.qwencloudapi.com/apps/anthropic
AI_MODEL=qwen3.7-plus
AI_THINKING=false
AI_MONTHLY_BUDGET_USD=5
AI_USER_DAILY_QUESTIONS=15
AI_ENABLED_ROLES=admin,engineer
AI_PRICE_IN_PER_M=0.40
AI_PRICE_CACHED_PER_M=0.08
AI_PRICE_OUT_PER_M=1.60
