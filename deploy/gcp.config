# Official production settings for deploy/gcp.sh (sourced by it). No secrets here: tokens, keys and
# passwords live in Secret Manager / .env. An environment variable of the same name overrides a value
# for one run, e.g.  COSTGUARD_DRY_RUN=true deploy/gcp.sh costguard
# Sizing and costs: docs/plans/gcp-production.md (test month from 2026-11-13, scenario A).

# --- Project ------------------------------------------------------------------------------------
: "${PROJECT:=tcroof-string-analysis}"
: "${REGION:=us-central1}"
: "${ZONE:=us-central1-a}"

# --- Database VM "tcroof-db" (Postgres 16 + growatt-worker) ---------------------------------------
: "${MACHINE_TYPE:=e2-standard-2}"     # 2 vCPU / 8 GB                          ฿1,663/month
: "${DISK_TYPE:=pd-balanced}"
: "${DISK_GB:=100}"                    # 90 days of readings for 629 inverters    ฿340/month
: "${RETENTION_DAYS:=90}"              # HISTORY_RETENTION_DAYS on the VM and Cloud Run
: "${STORE_RAW:=true}"                 # HISTORY_STORE_RAW on the VM: keep every field of each max_data record
: "${RAW_RETENTION_DAYS:=30}"          # HISTORY_RAW_RETENTION_DAYS: about 0.7 GB/day before Postgres compression
: "${HISTORY_INTERVAL_MIN:=10}"        # WORKER_HISTORY_INTERVAL_MIN on the VM: history (max_data + meter_data) pull; was 30 until 2026-11-16
: "${ENV_INTERVAL_MIN:=15}"            # WORKER_ENV_INTERVAL_MIN on the VM: env_history (weather sensors, 05–20); 0 = off. 15 = 10012 trial from 2026-11-14, then 10 or 15

# --- Backups: weekly only, no daily backup ------------------------------------------------------
: "${SNAPSHOT_DAY_UTC:=saturday}"      # Saturday 19:00 UTC = Sunday 02:00 Bangkok
: "${SNAPSHOT_HOUR_UTC:=19}"
: "${SNAPSHOT_KEEP_DAYS:=28}"          # 4 weekly snapshots                       ≤ ฿104/month

# --- API on Cloud Run "tcroof-api" ----------------------------------------------------------------
: "${API_MIN_INSTANCES:=0}"            # scale to zero (cold start of a few s); 1 = always on, +฿447/month; max stays 1

# --- Monthly cost cap ---------------------------------------------------------------------------
: "${BUDGET_AMOUNT:=3000THB}"          # budget "tcroof-monthly"; emails at 50/90/100 % (+ forecast); planned spend ≈ ฿2,566
: "${COST_CAP_PCT:=96}"                # cost guard disables billing at ฿2,880 (hard stop)
: "${COSTGUARD_DRY_RUN:=false}"        # true = log only, never disable billing

# --- Alerts -------------------------------------------------------------------------------------
: "${ALERT_EMAIL:=}"                   # empty = the gcloud account running deploy/gcp.sh monitoring

# --- AI Assistant (Cloud Run env; the key is secret tcroof-ai-api-key: deploy/gcp.sh ai) -----------
: "${AI_MODEL:=qwen3.7-plus}"          # Qwen Cloud Singapore; qwen3.7-max is more accurate, ~7x the cost
: "${AI_ENABLED_ROLES:=admin}"         # first week admins only; then admin,engineer
: "${AI_MONTHLY_BUDGET_USD:=5}"        # hard cap in the app (429 until the 1st); set a limit in Model Studio too
: "${AI_USER_DAILY_QUESTIONS:=15}"     # per engineer per Bangkok day (admins exempt)
: "${AI_TURN_TIMEOUT_S:=110}"          # the chat goes straight to Cloud Run (timeout 300 s), not through Hosting's 60 s rewrite

# --- Alarm push notifications (FCM web push) ------------------------------------------------------
# The Firebase web app's config and Web Push key: public values (every browser gets them), not
# secrets. Any of the four empty = push off (the UI hides its button). Get them with
#   bunx firebase-tools apps:sdkconfig WEB --project tcroof-string-analysis
# and Firebase console > Project settings > Cloud Messaging > Web Push certificates.
: "${FIREBASE_WEB_API_KEY:=AIzaSyAG588GkYk5PRH1iR9EBOfBPt-0o_GEIXA}"
: "${FIREBASE_WEB_APP_ID:=1:764090327267:web:e64c3e8a9c8b3b61a5e5d6}"
: "${FIREBASE_MESSAGING_SENDER_ID:=764090327267}"
: "${FIREBASE_VAPID_KEY:=BJ4-trv1Ubzk52m1TiOAu9_Fnh3GqUCFG3m6VSI6xSvgWaRlSRqlCe0LDggmcZ-PLAgQ3i-CUuNA__bS1BT9vI0}"
: "${BLOCKED_PLANT_IDS:=10838528}"     # GROWATT_BLOCKED_PLANT_IDS on the VM and Cloud Run (comma separated): 10838528 = สถานีจ่ายน้ำบางแสน กปภ.ชลบุรี ver.2
: "${PUSH_ALARM_LEVELS:=fault}"        # which alarms are pushed: fault | fault,warning | fault,warning,info

# --- Frontend mock pages (build-time VITE_* flags) ------------------------------------------------
# Measuring Tools runs on in-browser mock data (tab memory only, "Mock data" banner) until the
# backend has /tools. Set to 0 once that endpoint is deployed. (Claims has its backend: /claims.)
: "${TOOLS_MOCK:=1}"                   # VITE_TOOLS_MOCK: Operations → Measuring Tools
