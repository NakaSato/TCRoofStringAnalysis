{
  "_doc": "Per job: env = extra variables for both workers; stubs = stub servers to start (growatt, weather); tables = what the job may write, compared row by row after the run (order = ORDER BY columns, ignore = columns not compared, e.g. now() stamps the job writes). sync_runs and app_logs are always compared (compare.py). detail_ignore = keys of the run's detail_json not compared (dot paths).",
  "retention": {
    "env": {"LOG_MAX_ROWS": "8"},
    "stubs": [],
    "tables": {
      "growatt_inverter_readings": {"order": ["device_sn", "timestamp"]},
      "growatt_env_readings": {"order": ["datalogger_sn", "address", "timestamp"]},
      "growatt_meter_readings": {"order": ["datalogger_sn", "address", "timestamp"]},
      "growatt_string_records": {"order": ["device_sn", "timestamp"]},
      "growatt_inverter_raw": {"order": ["device_sn", "timestamp"]},
      "google_weather_hourly": {"order": ["cell_key", "hour"]},
      "growatt_alarms": {"order": ["id"]},
      "growatt_alarm_syncs": {"order": ["device_sn", "day"]},
      "pwa_check_slots": {"order": ["day", "plant_id", "hour"]},
      "growatt_plant_power": {"order": ["plant_id", "timestamp"]},
      "alarm_push_marks": {"order": ["device_sn", "alarm_code", "day"]},
      "om_push_marks": {"order": ["user_id", "kind", "day"]}
    }
  },
  "fleet": {
    "_doc": "present = columns compared only as set / NULL (now() stamps). Phase 2 = the stub's fleet world (plants 3001-3009, seed.d/30_fleet_power_limits.sql); 3009 is blocked.",
    "env": {"GROWATT_TOKEN_PHASE2": "fleet-stub-phase2", "GROWATT_BLOCKED_PLANT_IDS": "3009", "WORKER_PARALLEL_ACCOUNTS": "false"},
    "stubs": ["growatt"],
    "log_ignore": ["^phase \\d+ done in "],
    "tables": {
      "growatt_plants": {"order": ["plant_id"], "present": ["synced_at", "details_synced_at"]},
      "growatt_inverters": {"order": ["device_sn"], "present": ["synced_at", "info_synced_at", "param_synced_at", "power_limit_read_at", "not_installed_at"]},
      "growatt_env_sensors": {"order": ["datalogger_sn", "address"], "present": ["synced_at"]},
      "growatt_meters": {"order": ["datalogger_sn", "address"], "present": ["synced_at"]},
      "growatt_inverter_readings": {"order": ["device_sn", "timestamp"]},
      "growatt_issues": {"order": ["id"], "present": ["created_at", "updated_at"]},
      "om_tasks": {"order": ["id"], "present": ["created_at", "updated_at"]},
      "om_task_assignees": {"order": ["task_id", "user_id"]},
      "om_cleaning_suggestion_marks": {"order": ["plant_id", "reset_day"], "present": ["at"]},
      "om_plan_plants": {"order": ["plan_id", "plant_id"]},
      "om_plant_settings": {"order": ["plant_id"], "present": ["updated_at"]},
      "plant_documents": {"order": ["id"], "present": ["created_at", "updated_at"]},
      "site_register": {"order": ["site_code"], "present": ["imported_at"]},
      "site_devices": {"order": ["id"]}
    }
  },
  "power_limits": {
    "env": {"GROWATT_TOKEN_PHASE2": "fleet-stub-phase2", "WORKER_PARALLEL_ACCOUNTS": "false"},
    "stubs": ["growatt"],
    "log_ignore": ["^phase \\d+ done in "],
    "tables": {
      "growatt_inverters": {"order": ["device_sn"], "present": ["synced_at", "info_synced_at", "param_synced_at", "power_limit_read_at", "not_installed_at"]}
    }
  }
}
