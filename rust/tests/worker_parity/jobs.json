  "_doc_google_weather": "google_weather / google_weather_quota / google_weather_off: seed = extra SQL files of seed.job/ applied to this entry's two copies only. The weather stub answers history/hours (rust/tests/parity/weather_stub.py). Python then re-publishes yesterday (JSON sink, into the run's temp folder via pyshim/sitecustomize.py); publish is not ported in this wave (Rust records republished_yesterday as not available), so republished_yesterday and the publish's log lines are not compared.",
  "google_weather": {
    "seed": ["google_weather.sql"],
    "stubs": ["weather"],
    "detail_ignore": ["republished_yesterday"],
    "log_ignore": ["^published ", "^publish "],
    "tables": {
      "google_weather_hourly": {"order": ["cell_key", "hour"], "ignore": ["fetched_at"]},
      "external_api_call_counts": {"order": ["api", "day"]}
    }
  },
  "google_weather_quota": {
