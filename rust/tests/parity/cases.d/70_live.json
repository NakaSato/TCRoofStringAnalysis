{
 "_doc": "Growatt live routes against the stub Growatt (growatt_stub.py, started by run.sh). Ignored: fetched_at (each backend's own fetch time) and, where the value depends on when the request lands, refresh_in_s (cached repeats count down from each backend's own fetch; /latest expiry is measured from the record time to each backend's clock). Night TTL stretching is off in the parity run (GROWATT_LIVE_NIGHT_TTL_S=0). The engineer's plants are set to [7001] for these cases (cases.json reassigns them) and restored at the end.",
 "cases": [
  {
   "name": "live: setup save engineer plants",
   "method": "GET",
   "path": "/api/auth/me",
   "auth": "engineer",
   "save": {
    "live_eng_plants": "plant_ids"
   }
  },
  {
   "name": "live: setup assign engineer 7001",
   "method": "PUT",
   "path": "/api/users/${eng_id}/plants",
   "auth": "admin",
   "body": {
    "plant_ids": [
     7001
    ]
   }
  },
  {
   "name": "live: plants admin",
   "method": "GET",
   "path": "/api/growatt/live/plants",
   "auth": "admin",
   "ignore": [
    "fetched_at"
   ]
  },
  {
   "name": "live: plants engineer (cached, filtered)",
   "method": "GET",
   "path": "/growatt/live/plants",
   "auth": "engineer",
   "ignore": [
    "fetched_at",
    "refresh_in_s"
   ]
  },
  {
   "name": "live: plants unauthenticated",
   "method": "GET",
   "path": "/growatt/live/plants",
   "auth": null
  },
  {
   "name": "live: plants today admin (sweep, refused, unknown phase)",
   "method": "GET",
   "path": "/api/growatt/live/plants/today",
   "auth": "admin",
   "ignore": [
    "fetched_at",
    "data.*.fetched_at",
    "data.plants.*.fetched_at",
    "data.inverters.*.fetched_at",
    "data.dataloggers.*.fetched_at"
   ]
  },
