  {
   "name": "plants: (setup) engineer id",
   "method": "GET",
   "path": "/api/auth/me",
   "auth": "engineer",
   "save": {
    "plants_eng_id": "id"
   },
   "ignore": [
    "plant_ids"
   ]
  },
  {
   "name": "plants: (setup) assign 2001 to the engineer",
   "method": "PUT",
   "path": "/api/users/${plants_eng_id}/plants",
   "auth": "admin",
   "body": {
    "plant_ids": [
     2001,
     10,
     30
    ]
   }
  },
